platform :ios, '14.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Workaround for razorpay_flutter Swift header import issue
  begin
    require 'json'
    dependencies_file = File.join(__dir__, '..', '.flutter-plugins-dependencies')
    if File.exist?(dependencies_file)
      dependencies = JSON.parse(File.read(dependencies_file))
      ios_plugins = dependencies.dig('plugins', 'ios') || []
      razorpay_plugin = ios_plugins.find { |p| p['name'] == 'razorpay_flutter' }
      if razorpay_plugin && razorpay_plugin['path']
        raw_path = razorpay_plugin['path']
        normalized_path = raw_path.gsub('\\', '/')
        file_path = File.join(normalized_path, 'ios', 'Classes', 'RazorpayFlutterPlugin.m')
        if File.exist?(file_path)
          text = File.read(file_path)
          target_import_regex = /#import [<"]razorpay_flutter\/razorpay_flutter-Swift\.h[>"]/
          replacement_import = '#import "razorpay_flutter-Swift.h"'
          if text =~ target_import_regex
            new_text = text.gsub(target_import_regex, replacement_import)
            File.chmod(0644, file_path) rescue nil
            File.open(file_path, "w") { |file| file.write(new_text) }
            puts "Successfully patched razorpay_flutter at: #{file_path}"
          end
        end
      end
    end
  rescue => e
    puts "Error patching razorpay_flutter: #{e.message}"
  end
end