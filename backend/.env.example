# Django Core Settings
DJANGO_SECRET_KEY=your-long-random-production-secret-key-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.thebaronclub.com,thebaronclub.com,localhost,127.0.0.1

# MySQL Database Configuration
DB_NAME=your_production_db_name
DB_USER=your_production_db_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://thebaronclub.com,https://api.thebaronclub.com,https://admin.thebaronclub.com

# Email Settings (SMTP via SSL)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@thebaronclub.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=info@thebaronclub.com
EMAIL_TIMEOUT=30

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY=rzp_live_your_key_id
RAZORPAY_SECRET=your_razorpay_secret_key

# Secondary / REST API Email Fallback (optional)
EMAIL_REST_API_URL=https://thebaronclub.com/api/send-email
EMAIL_REST_API_TOKEN=your_email_api_token

# Firebase Cloud Messaging Service Account Credentials Path
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Production Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
